<mxfile host="app.diagrams.net" agent="alpha-shoop" version="24.0.0">
  <diagram name="Sol — Responsibilities" id="sol-arch-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Sol — Single Autonomous Agent (run_sol_task · Opus · English-only · narrates to Slack)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="30" as="geometry" />
        </mxCell>

        <!-- Owner / Slack -->
        <mxCell id="owner" value="Owner (Itzik)&#10;via Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Sol (center) -->
        <mxCell id="sol" value="SOL&#10;full-stack store builder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4B0082;strokeColor=#6d28d9;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- Responsibilities header -->
        <mxCell id="resphdr" value="Sol is responsible for:" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Responsibility 1: Development -->
        <mxCell id="dev" value="1 · Development&#10;Hydrogen/React code, routes, components, build &amp; deploy (preview→prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Responsibility 2: UI/UX -->
        <mxCell id="uiux" value="2 · UI / UX&#10;theme.config.json (brand, colors, fonts, hero, nav), visual polish, mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="190" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Responsibility 3: Products from CJ -->
        <mxCell id="cjprod" value="3 · Products from CJ&#10;source &amp; vet (≥3 images, video-first), publish to Shopify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Responsibility 4: Shopify Admin -->
        <mxCell id="shopadmin" value="4 · Shopify Admin&#10;manage store data: collections, prices, SEO, variants, images (GraphQL Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="370" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Responsibility 5: Fulfillment -->
        <mxCell id="fulfill" value="5 · Send products to customers&#10;fulfillment via CJ (orders + tracking) → delivered to the buyer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
