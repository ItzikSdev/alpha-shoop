# Copy to .env and fill in real values:  cp .env.example .env

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram (the company's chat interface — replaces Slack) ─────────────────
# 1. Message @BotFather → /newbot → paste the token it gives you below.
# 2. Message @userinfobot (or @get_id_bot) → it replies with your numeric
#    Telegram user id → TELEGRAM_ALLOWED_USER_ID. Only THIS user's messages
#    are read; everyone else is silently ignored.
# 3. Send your new bot any message first (Telegram won't let a bot DM you
#    until you've messaged it), then set TELEGRAM_CHAT_ID — for a 1:1 chat
#    with the bot this is the SAME number as TELEGRAM_ALLOWED_USER_ID.
# 4. Optional — only if TELEGRAM_CHAT_ID is a supergroup with Topics enabled:
#    TELEGRAM_MAIN_THREAD_ID for concise status updates, TELEGRAM_LOG_THREAD_ID
#    for verbose tool-call/result logs, so the two stay visually separate.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_MAIN_THREAD_ID=
TELEGRAM_LOG_THREAD_ID=

# 5. Optional — per-agent bot identity (own name+avatar in the chat, not just a
#    text header). For EACH agent: message @BotFather → /newbot → get a token
#    → put it below. Create a Telegram GROUP, add your main bot AND every one
#    of these agent bots to it, set TELEGRAM_CHAT_ID to the GROUP's id (a
#    negative number — get it by adding @getidsbot to the group, or forwarding
#    a group message to @userinfobot). Any agent without a token here just
#    falls back to the shared bot with a text header instead — nothing breaks
#    if you only make some of these.
TELEGRAM_BOT_TOKEN_AVA=
TELEGRAM_BOT_TOKEN_SOL=
TELEGRAM_BOT_TOKEN_REEL=
TELEGRAM_BOT_TOKEN_NORA=
TELEGRAM_BOT_TOKEN_MILO=
# How often the CEO posts an unprompted roster status/next-steps report
# (also available any time via the /manager Telegram command).
MANAGER_CHECKIN_INTERVAL_HOURS=24

# Ava's Daily CEO Report (Revenue, TikTok ad spend/ROAS, bottlenecks, executed
# agent commands) — fires once per local calendar day once this hour has
# passed, also available any time via the /report Telegram command.
CEO_REPORT_HOUR=21
CEO_REPORT_TZ=Asia/Jerusalem

# Force every org agent onto the local qwen3 model (Ollama) instead of Anthropic,
# regardless of the $100/mo budget. 0/unset = budget-based auto-fallback instead.
ORG_LOCAL_LLM=0

# ── Support inbox (Nora) ──────────────────────────────────────────────────────
# ONE central Gmail mailbox (e.g. agent@central.com) that every store's own
# support@<domain> forwards into (Cloudflare Email Routing) — set up + owned by
# you, not built here. Same creds shape as a per-store mailbox in
# src/mcp_tools/email.py, just one global set for the central inbox.
SUPPORT_GMAIL_CLIENT_ID=
SUPPORT_GMAIL_CLIENT_SECRET=
SUPPORT_GMAIL_REFRESH_TOKEN=
# Outbound send — replies go out AS the store's own support address, not
# agent@central.com. Get a key at resend.com (needs your store domain verified).
RESEND_API_KEY=
SUPPORT_INBOX_POLL_SECONDS=120

# ── LiteLLM Proxy ────────────────────────────────────────────────────────────
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=alpha-shoop-local

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alphashoop
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
TRACES_DB_PATH=./data/traces.db

# ── FalkorDB (visual knowledge graph) ──────────────────────────────────────────
# Host port is remapped in docker-compose.yml (6380, not 6379 — that's already
# taken by the redis-stack-server above). Browser UI: http://localhost:3002
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# ── Shopify Dev Store ─────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_WEBHOOK_SECRET=

# ── CJ Dropshipping ───────────────────────────────────────────────────────────
CJ_EMAIL=your@email.com
CJ_API_KEY=
CJ_MCP_KEY=

# ── Google Ads ────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── TikTok Ads (Kai, growth marketing — read-only reporting via REAL MCP) ──────
# src/tiktok_mcp/ — a genuine MCP server we wrote ourselves (not a third-party
# repo), wrapping TikTok's documented Marketing API v1.3. See src/tiktok_mcp/README.md.
# 1. business-api.tiktok.com/portal → create a Developer app → add the
#    Marketing API product → request read-only Reporting + Ad Account scopes.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# 2. Must match the Developer app's registered redirect URI EXACTLY. TikTok
#    rejects localhost/loopback URIs outright — use a real domain you own; it
#    doesn't need to be a live server, you copy the auth_code off the URL by hand.
TIKTOK_OAUTH_REDIRECT=https://alphaforbaby.com/tiktok/callback
# 3. Leave these blank — ask Kai to connect (or call tiktok_ads_login /
#    tiktok_ads_complete_auth), and they get filled in here automatically.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── GCP (production / CI) ─────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ── Guardrails ────────────────────────────────────────────────────────────────
MAX_AD_SPEND_DAILY_USD=500
MAX_ORDER_VALUE_USD=200

# Where Kai looks for reports you export by hand from TikTok Ads Manager
# (used while the Developer app is still pending approval — see
# data/tiktok_exports/README.md). Defaults to ./data/tiktok_exports
TIKTOK_EXPORT_DIR=
