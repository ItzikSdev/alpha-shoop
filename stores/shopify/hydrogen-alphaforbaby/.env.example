# ALPHA FOR BABY — Hydrogen storefront env (example).
# Copy to `.env` for local dev. In production these live in the Oxygen
# storefront's env settings (Shopify admin → Hydrogen/Headless channel), NOT here.

SESSION_SECRET="change-me-to-a-random-string"

# Shopify Storefront API (PUBLIC, read-only). Mint via Admin API
# storefrontAccessTokenCreate, or use the token from the Headless/Hydrogen channel.
PUBLIC_STORE_DOMAIN="kgg8n0-k0.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="your-public-storefront-api-token"
PUBLIC_STOREFRONT_API_VERSION="2025-01"
PUBLIC_CHECKOUT_DOMAIN="kgg8n0-k0.myshopify.com"

# Optional (analytics / customer accounts — set once the Headless channel exists):
# PUBLIC_STOREFRONT_ID=""
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# Shopify ADMIN API (PRIVATE — server-side only, never PUBLIC_-prefixed so it's
# never sent to the browser bundle). Used only by the product-reviews action
# (app/routes/products.$handle.jsx) to write the "custom.reviews" metafield.
# Mint via Shopify Admin → Settings → Apps → Develop apps → (create/select an
# app) → Admin API scopes: write_products, read_products → install → reveal token.
SHOPIFY_ADMIN_TOKEN="shpat_..."
# The *.myshopify.com domain the Admin API actually lives on (can differ from
# PUBLIC_STORE_DOMAIN if that points at a storefront/custom domain instead).
SHOPIFY_ADMIN_STORE_DOMAIN="kgg8n0-k0.myshopify.com"
