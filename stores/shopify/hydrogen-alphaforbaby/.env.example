# ALPHA FOR BABY — Hydrogen storefront env (example).
# Copy to `.env` for local dev. In production these live in the Oxygen
# storefront's env settings (Shopify admin → Hydrogen/Headless channel), NOT here.

SESSION_SECRET="change-me-to-a-random-string"

# Shopify Storefront API (PUBLIC, read-only). Mint via Admin API
# storefrontAccessTokenCreate, or use the token from the Headless/Hydrogen channel.
PUBLIC_STORE_DOMAIN="kgg8n0-k0.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="your-public-storefront-api-token"
PUBLIC_STOREFRONT_API_VERSION="2025-01"
PUBLIC_CHECKOUT_DOMAIN="kgg8n0-k0.myshopify.com"

# Optional (analytics / customer accounts — set once the Headless channel exists):
# PUBLIC_STOREFRONT_ID=""
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# Shopify ADMIN API (PRIVATE — server-side only, never PUBLIC_-prefixed so it's
# never sent to the browser bundle). Used by the product-reviews action
# (app/routes/products.$handle.jsx) AND by the entire independent customer
# identity system (app/lib/customer.js) — this shop has Classic customer
# accounts DISABLED, so we don't use Shopify's own login/activation at all;
# Shopify Customer records are read/written here purely as CRM/order data.
# Needs read_customers + write_customers scopes in addition to
# write_products/read_products.
# Mint via Shopify Admin → Settings → Apps → Develop apps → (create/select an
# app) → Admin API scopes → install → reveal token.
SHOPIFY_ADMIN_TOKEN="shpat_..."
# The *.myshopify.com domain the Admin API actually lives on (can differ from
# PUBLIC_STORE_DOMAIN if that points at a storefront/custom domain instead).
SHOPIFY_ADMIN_STORE_DOMAIN="kgg8n0-k0.myshopify.com"

# --- "Sign in with Google" (app/routes/account_.login.google*.jsx) ---------
# OAuth 2.0 Client (Web application) from Google Cloud Console. Authorized
# redirect URIs must include both:
#   http://localhost:3001/account/login/google/callback
#   https://alphaforbaby.com/account/login/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- "Sign in with Apple" (app/routes/account_.login.apple*.jsx) -----------
# Services ID configured in Apple's developer portal. Apple's Return URL for
# this client can ONLY be registered as
# https://alphaforbaby.com/account/login/apple/callback — there is no
# localhost option, so this flow can only be exercised end-to-end in
# production, not local dev.
APPLE_CLIENT_ID="com.alphaforbaby.web"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# PEM contents of the private key (.p8) downloaded when the Sign in with
# Apple key was created. If pasted on one line, escape newlines as `\n` —
# app/routes/account_.login.apple.callback.jsx normalizes either form.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
