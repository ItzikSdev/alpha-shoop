graph LR
    subgraph AGENTS["7 agents — each with their own real tool set"]
        direction TB
        AVA["Ava · CEO\nmanagement · operations · shopify"]
        SOL["Sol · sourcing & copy\nshopify · sourcing · knowledge · ask_teammate"]
        REEL["Reel · video\nvideo · image · catalog"]
        NORA["Nora · support\ninbox · comms · knowledge"]
        MILO["Milo · fulfillment\nfulfillment · comms\n(deterministic, no LLM tool loop)"]
        KAI["Kai · TikTok Ads + Clarity\nads_auth · ads_reporting · analytics_reporting"]
        NOVA["Nova · stay-on-target\noversight · knowledge · ads_reporting ·\nshopify_reporting · market_research · diagnostics\n(read-only — no execute authority)"]
    end

    subgraph REALMCP["Real MCP-protocol servers (stdio)"]
        direction TB
        CJMCP["cj_mcp\nsrc/cj_mcp/client.py — inventory + tracking\nJWT via cj_mcp_key"]
        TIKTOKMCP["tiktok_mcp\nsrc/tiktok_mcp/server.py — real MCP SDK\nserver+client, read-only"]
    end

    subgraph PLAINTOOLS["Plain Python tool modules — NOT MCP protocol, called directly by agent handlers"]
        direction TB
        SOURCING["sourcing.py / cj_connect.py\nsearch_trending_products, cj_search_products,\ncj_add_product, cj_stock_sweep"]
        SHOPIFY["shopify.py / shopify_auth.py\nshopify_admin, publish_products,\nget_sales_summary"]
        SUPPORTINBOX["support_inbox.py\nprocess_central_inbox, list_new_support_emails,\nsend_reply_via_resend"]
        EMAILPY["email.py\nsend_email — Milo's fulfillment\nconfirmation/tracking notices"]
        FULFILL["fulfillment.py\nprocess_order() — deterministic,\nno LLM reasoning on the happy path"]
        CLARITY["clarity.py — added 2026-09-02\nget_clarity_report; honest\nstatus=not_connected until token is set"]
        VIDEO["video/veo_video.py + gemini_images.py\nrotation video (~$0.40/clip) + product photos —\nreplaced local Wan2.2/ComfyUI 2026-08-20"]
        MARKET["market.py\nsearch_web / search_market_prices\n(Serper — Nova's outside-context tool)"]
        FINANCE["finance.py\nintegrations_status, finance_snapshot —\nfeeds the platform-app Integrations/Finance pages"]
    end

    AVA --> SHOPIFY
    SOL --> SOURCING & SHOPIFY & CJMCP
    REEL --> VIDEO
    NORA --> SUPPORTINBOX
    MILO --> FULFILL & EMAILPY
    KAI --> TIKTOKMCP & CLARITY
    NOVA --> MARKET

    CJ["CJ Dropshipping"]
    SHOPADM["Shopify Admin API\nGraphQL 2024-07"]
    TIKTOKAPI["TikTok Marketing API"]
    GMAIL["Gmail\ncentral mailbox, one per company"]
    CLARITYAPI["Microsoft Clarity\nData Export API"]
    GOOGLEAPI["Google Veo + Gemini\npaid APIs"]
    SERPERAPI["Serper\nweb search"]

    SOURCING & CJMCP --> CJ
    SHOPIFY --> SHOPADM
    TIKTOKMCP --> TIKTOKAPI
    SUPPORTINBOX & EMAILPY --> GMAIL
    CLARITY --> CLARITYAPI
    VIDEO --> GOOGLEAPI
    MARKET --> SERPERAPI

